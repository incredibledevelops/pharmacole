# ==============================================================================
# PHARMACOLE — Environment Variables Example
# ==============================================================================
# Copy this file to `.env` and fill in the real values.
# NEVER commit your actual `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FLASK CORE
# ------------------------------------------------------------------------------
# Options: development | production | testing
FLASK_ENV=development
FLASK_DEBUG=1

# Generate a strong secret. In production this is REQUIRED.
# Run: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Force HTTPS (set to 1 in production behind a reverse proxy)
PREFERRED_URL_SCHEME=http

# Absolute base URL of your app (NO trailing slash). 
# Used for Paystack callbacks, QR codes, and email links.
# For local dev: http://127.0.0.1:5005
# For production: https://pharmacole.kwiqbuy.com
APP_BASE_URL=http://127.0.0.1:5005

# ------------------------------------------------------------------------------
# 2. MONGODB
# ------------------------------------------------------------------------------
# Local:      mongodb://127.0.0.1:27017/pharmacole
# Atlas:      mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/pharmacole
MONGO_URI=mongodb://127.0.0.1:27017/pharmacole
MONGO_DB_NAME=pharmacole

# Separate DB for pytest (used by TestingConfig)
MONGO_URI_TEST=mongodb://127.0.0.1:27017/pharmacole_test

# ------------------------------------------------------------------------------
# 3. PAYSTACK (Billing / Subscription)
# ------------------------------------------------------------------------------
# Get these from: https://dashboard.paystack.com/#/settings/developers
# Use TEST keys (pk_test_..., sk_test_...) for local dev.
# Use LIVE keys (pk_live_..., sk_live_...) only in production.
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co

# ------------------------------------------------------------------------------
# 4. SUPER ADMIN (created by scripts/seed_super_admin.py)
# ------------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@pharmacole.com
SUPER_ADMIN_PASSWORD=ChangeMe123!StrongPassword

# ------------------------------------------------------------------------------
# 5. SESSION & SECURITY
# ------------------------------------------------------------------------------
# Set to 1 in production (HTTPS only). Keep 0 for local http:// dev.
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_DAYS=7

# JSON Web Token for the stateless /api/v1/* endpoints.
# MUST be a strong random string in production.
# Run: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_TTL_DAYS=30
JWT_REFRESH_TTL_DAYS=120

# Comma-separated list of allowed origins, or * for all.
# For production, use your actual domain:
# CORS_ORIGINS=https://pharmacole.kwiqbuy.com
CORS_ORIGINS=*

# Rate limiting storage. Use `memory://` for dev, Redis in production:
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=1000 per day;200 per hour

# Max upload size in MB (logos, etc.)
MAX_CONTENT_LENGTH_MB=8

# ------------------------------------------------------------------------------
# 6. SUBSCRIPTION DEFAULTS
# ------------------------------------------------------------------------------
SUBSCRIPTION_AMOUNT=500.0
SUBSCRIPTION_CURRENCY=GHS
SUBSCRIPTION_DURATION_DAYS=30

# ------------------------------------------------------------------------------
# 7. EMAIL — Resend (receipts, notifications)
# ------------------------------------------------------------------------------
# Leave blank to disable email sending (calls will raise RuntimeError).
# Sign up: https://resend.com
RESEND_API_KEY=
# Must be a verified domain on Resend. Format: "Name <email@domain.com>"
RESEND_FROM_EMAIL=Pharmacole <receipts@yourdomain.com>

# ------------------------------------------------------------------------------
# 8. SMS — Arkesel (receipts, alerts)
# ------------------------------------------------------------------------------
# Leave blank to disable SMS sending.
# Sign up: https://sms.arkesel.com
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=Pharmacole
ARKESEL_BASE_URL=https://sms.arkesel.com/api/v2

# ------------------------------------------------------------------------------
# 9. WEB PUSH (PWA notifications)
# ------------------------------------------------------------------------------
# Generate VAPID keys with: `npx web-push generate-vapid-keys`
# Or use: https://web-push-codelab.glitch.me/
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

# ------------------------------------------------------------------------------
# 10. FILE UPLOADS
# ------------------------------------------------------------------------------
# Absolute or relative path where logos are stored.
# Default: <project_root>/uploads
UPLOAD_FOLDER=uploads

# ------------------------------------------------------------------------------
# 11. DEVELOPMENT / TESTING
# ------------------------------------------------------------------------------
# If 1, the Flask dev server auto-reloads on code changes.
FLASK_USE_RELOADER=1
PORT=5005