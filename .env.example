# =============================================================================
# Pharmacole — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in real values.
#
#   PowerShell:  Copy-Item .env.example .env
#   Bash:        cp .env.example .env
#
# Never commit `.env` to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# Flask core
# -----------------------------------------------------------------------------
# development | production | testing
FLASK_ENV=development

# Set DEBUG=1 only in development. Production must be 0.
FLASK_DEBUG=0

# Prefer "0" so `python run.py` doesn't fork the reloader on Windows.
FLASK_USE_RELOADER=0

# Flask session signing key. MUST be a long random string in production.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string

# URL scheme Flask should generate in url_for(_external=True).
#   development: http
#   production:  https
PREFERRED_URL_SCHEME=http

# The public base URL of your app. Used for receipt QR codes, Paystack
# callback URLs, upload URLs, and email links.
#   development: http://localhost:5005
#   production:  https://yourdomain.com
APP_BASE_URL=http://localhost:5005

# Port for `python run.py`. Gunicorn ignores this (it uses its own flag).
PORT=5005


# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
# MongoDB connection string.
#   Local:  mongodb://127.0.0.1:27017/pharmacole
#   Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/pharmacole

# Database name. Must match the path/query of MONGO_URI.
MONGO_DB_NAME=pharmacole

# Test database (used by pytest). Kept separate so tests never touch dev data.
MONGO_URI_TEST=mongodb://127.0.0.1:27017/pharmacole_test


# -----------------------------------------------------------------------------
# Sessions & cookies
# -----------------------------------------------------------------------------
# Set to 1 in production (requires HTTPS).
SESSION_COOKIE_SECURE=0

# Lax | Strict | None
SESSION_COOKIE_SAMESITE=Lax

# How many days a session stays valid (also controls the "remember me" TTL).
PERMANENT_SESSION_LIFETIME_DAYS=7


# -----------------------------------------------------------------------------
# JWT (API authentication)
# -----------------------------------------------------------------------------
# Separate secret for signing API tokens. If unset, falls back to SECRET_KEY.
# Production REFUSES to boot if both SECRET_KEY and JWT_SECRET are unset/insecure.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-different-long-random-string

# Access token lifetime (used by /api/session-token for browser → API calls).
JWT_ACCESS_TTL_DAYS=30

# Refresh token lifetime (reserved; not currently issued).
JWT_REFRESH_TTL_DAYS=120


# -----------------------------------------------------------------------------
# CORS (API access from Electron desktop app / external integrations)
# -----------------------------------------------------------------------------
# "*" to allow all origins (development only).
# Or a space/comma-separated list, e.g.:
#   CORS_ORIGINS=https://app.yourdomain.com https://admin.yourdomain.com
CORS_ORIGINS=*


# -----------------------------------------------------------------------------
# Paystack (subscription billing)
# -----------------------------------------------------------------------------
# Get keys from https://dashboard.paystack.com/#/settings/developers
# Use test keys (sk_test_… / pk_test_…) for development,
# live keys (sk_live_… / pk_live_…) for production.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Paystack API base URL. Don't change unless Paystack tells you to.
PAYSTACK_BASE_URL=https://api.paystack.co

# Subscription pricing.
SUBSCRIPTION_CURRENCY=GHS
SUBSCRIPTION_AMOUNT=500.0
SUBSCRIPTION_DURATION_DAYS=30


# -----------------------------------------------------------------------------
# Email — Resend
# -----------------------------------------------------------------------------
# Get your API key from https://resend.com/api-keys
# Leave blank to disable email sending (calls become no-ops and return 502).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "From" address. MUST be on a domain verified in Resend.
# Supports display names:
#   RESEND_FROM_EMAIL=Pharmacole <receipts@yourdomain.com>
RESEND_FROM_EMAIL=Pharmacole <receipts@yourdomain.com>


# -----------------------------------------------------------------------------
# SMS — Arkesel
# -----------------------------------------------------------------------------
# Get your API key from https://sms.arkesel.com/user/sms-api/info
# Leave blank to disable SMS sending (calls become no-ops and return 502).
ARKESEL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The registered sender ID (e.g. "Pharmacole"). Ghana requires approval;
# unapproved IDs fall back to a shared short code.
ARKESEL_SENDER_ID=Pharmacole

# Arkesel API base URL. Don't change unless Arkesel tells you to.
ARKESEL_BASE_URL=https://sms.arkesel.com/api/v2


# -----------------------------------------------------------------------------
# Web Push (VAPID) — browser notifications
# -----------------------------------------------------------------------------
# Generate a key pair with:
#   python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print('public:', v.public_key_urlsafe_base64()); print('private:', v.private_key_urlsafe_base64())"
# Or use https://web-push-codelab.glitch.me/
# Leave blank to disable web push (subscriptions will be stored but not sent).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com


# -----------------------------------------------------------------------------
# Super admin seed
# -----------------------------------------------------------------------------
# Used by `python -m scripts.seed_super_admin` to create the first
# super-admin account. Change the password immediately after first login!
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=ChangeThisPasswordNow!


# -----------------------------------------------------------------------------
# File uploads
# -----------------------------------------------------------------------------
# Where uploaded logos / attachments are stored.
# Leave blank to default to ./uploads (created automatically).
UPLOAD_FOLDER=uploads

# Max request size in MB (uploaded logos, attachments).
MAX_CONTENT_LENGTH_MB=8

# File extensions allowed for logo uploads. Comma-separated, no dots.
# (This is not read from env — it's in config.py — but documented here for completeness.)
# ALLOWED_LOGO_EXT=png,jpg,jpeg,webp,svg


# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Storage backend for rate-limit counters.
#   memory://            — per-process (development / single worker)
#   redis://localhost:6379/0 — shared across workers (production)
RATELIMIT_STORAGE_URI=memory://

# Global default limits. Per-route limits (auth.login, cashier.checkout, etc.)
# are applied in code and override these.
RATELIMIT_DEFAULT=1000 per day;200 per hour


# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# • Production boot fails if SECRET_KEY or JWT_SECRET is missing/insecure.
# • Set SESSION_COOKIE_SECURE=1 and PREFERRED_URL_SCHEME=https in production.
# • Point MONGO_URI at Atlas or a replica set before enabling multi-worker
#   gunicorn — the in-process default is fine for single-worker dev only.
# • RATELIMIT_STORAGE_URI=memory:// won't share counters across workers;
#   use Redis in production if you run more than one gunicorn worker.
# =============================================================================